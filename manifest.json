{
  "manifest_version": 3,
  "name": "SteGOG",
  "version": "0.0.22",
  "description": "Display games owned on Steam in GOG",

  "icons": {
    "48": "icons/stegog-48.png",
    "128": "icons/stegog-128.png"
  },
  "options_ui": {
    "page": "src/options.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://api.steampowered.com/*", "*://api.isthereanydeal.com/*"],
  "background": {
    "scripts": ["lib/browser-polyfill.min.js", "src/background.js"],
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.gog.com/*"],
      "js": ["lib/browser-polyfill.min.js", "lib/lodash.min.js", "lib/bluebird.min.js", "src/stegog.js"],
      "css": ["src/stegog.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stegog@ugzuzg.com.amo"
    }
  },
  "web_accessible_resources": [{ "resources": ["images/g99.png"], "matches": ["<all_urls>"] }]
}
